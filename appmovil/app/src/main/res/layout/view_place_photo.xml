<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="176dp" android:layout_height="wrap_content"
    android:layout_marginEnd="8dp" app:cardCornerRadius="14dp"
    app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:orientation="vertical">
        <ImageView android:id="@+id/placePhotoThumb"
            android:layout_width="match_parent" android:layout_height="118dp"
            android:contentDescription="Abrir foto del lugar" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="8dp" android:paddingEnd="8dp">
            <ImageView android:id="@+id/placePhotoAuthorAvatar"
                android:layout_width="28dp" android:layout_height="28dp"
                android:background="@drawable/bg_profile_avatar"
                android:contentDescription="Foto de quien subió la imagen"
                android:scaleType="centerCrop" />
            <TextView android:id="@+id/placePhotoAuthorName"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/app_text_primary" android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
