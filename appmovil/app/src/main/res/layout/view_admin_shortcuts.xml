<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/white" android:paddingHorizontal="12dp" android:scrollbars="none">
    <com.google.android.material.chip.ChipGroup android:id="@+id/adminShortcutGroup"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp" app:selectionRequired="true" app:singleSelection="true">
        <com.google.android.material.chip.Chip android:id="@+id/adminShortcutSummary"
            style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" android:text="Resumen" />
        <com.google.android.material.chip.Chip android:id="@+id/adminShortcutReports"
            style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Reportes" />
        <com.google.android.material.chip.Chip android:id="@+id/adminShortcutPlaces"
            style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Lugares" />
    </com.google.android.material.chip.ChipGroup>
</HorizontalScrollView>
