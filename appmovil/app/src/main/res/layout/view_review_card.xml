<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp" app:cardElevation="1dp"
    app:strokeColor="@color/app_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/reviewAvatar" android:layout_width="38dp"
                android:layout_height="38dp" android:background="@drawable/bg_profile_avatar"
                android:contentDescription="Foto del usuario" android:scaleType="centerCrop" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/reviewAuthor" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/app_text_primary"
                    android:textStyle="bold" />
                <TextView android:id="@+id/reviewDate" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/reviewStars" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#D99A00" android:textSize="17sp" />
        </LinearLayout>
        <TextView android:id="@+id/reviewComment" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textColor="@color/app_text_secondary" android:textSize="14sp" />
        <ImageView android:id="@+id/reviewImage" android:layout_width="match_parent"
            android:layout_height="160dp" android:layout_marginTop="10dp"
            android:contentDescription="Abrir imagen de la reseña" android:scaleType="centerCrop"
            android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLikeReview"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="♡ Me gusta" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReportReview"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Reportar" />
        </LinearLayout>
        <LinearLayout android:id="@+id/reviewOwnerActions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="end"
            android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditReview"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editar" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteReview"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eliminar" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
