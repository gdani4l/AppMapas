<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReportZone"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:text="@string/report_zone"
        android:textColor="@color/app_primary_dark"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_dialog_alert"
        app:iconTint="@color/app_primary_dark"
        app:strokeColor="@color/app_primary" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddPlace"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:text="@string/add_place"
        android:textColor="@color/white"
        app:backgroundTint="@color/app_secondary"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white" />
</LinearLayout>
