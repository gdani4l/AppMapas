<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F6FA"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".registro">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp">

    <!-- Contenedor circular con color de acento para el icono superior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="#E0F2FE"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeColor="#BAE6FD"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivMapIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Icono de mapa"
            android:src="@android:drawable/ic_dialog_map"
            app:tint="#0284C7" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Título principal: App de mapas -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.02"
        android:text="Safe Map"
        android:textColor="#0F172A"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTopIcon" />

    <!-- Subtítulo: Registro de cuenta -->
    <TextView
        android:id="@+id/tvRegisterSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Registro de cuenta"
        android:textColor="#0284C7"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

    <!-- ================= FILA 1: NOMBRES (2 COLUMNAS) ================= -->

    <!-- Etiqueta: Primer nombre -->
    <TextView
        android:id="@+id/tvFirstNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:text="Primer nombre"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/cardFirstNameInput"
        app:layout_constraintTop_toBottomOf="@id/tvRegisterSubtitle" />

    <!-- Etiqueta: Segundo nombre -->
    <TextView
        android:id="@+id/tvSecondNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:text="Segundo nombre"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/cardSecondNameInput"
        app:layout_constraintTop_toBottomOf="@id/tvRegisterSubtitle" />

    <!-- Contenedor: Primer nombre -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFirstNameInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toStartOf="@id/cardSecondNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFirstNameLabel">

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="givenName"
            android:background="@android:color/transparent"
            android:hint="Primer nombre"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor: Segundo nombre -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSecondNameInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardFirstNameInput"
        app:layout_constraintTop_toBottomOf="@id/tvSecondNameLabel">

        <EditText
            android:id="@+id/etSecondName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="additionalName"
            android:background="@android:color/transparent"
            android:hint="Segundo nombre"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= FILA 2: APELLIDOS (2 COLUMNAS) ================= -->

    <!-- Etiqueta: Apellido paterno -->
    <TextView
        android:id="@+id/tvPaternalLastNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Apellido paterno"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/cardPaternalLastNameInput"
        app:layout_constraintTop_toBottomOf="@id/cardFirstNameInput" />

    <!-- Etiqueta: Apellido materno -->
    <TextView
        android:id="@+id/tvMaternalLastNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Apellido materno"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/cardMaternalLastNameInput"
        app:layout_constraintTop_toBottomOf="@id/cardSecondNameInput" />

    <!-- Contenedor: Apellido paterno -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPaternalLastNameInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toStartOf="@id/cardMaternalLastNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPaternalLastNameLabel">

        <EditText
            android:id="@+id/etPaternalLastName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="familyName"
            android:background="@android:color/transparent"
            android:hint="Apellido paterno"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor: Apellido materno -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMaternalLastNameInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardPaternalLastNameInput"
        app:layout_constraintTop_toBottomOf="@id/tvMaternalLastNameLabel">

        <EditText
            android:id="@+id/etMaternalLastName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="familyName"
            android:background="@android:color/transparent"
            android:hint="Apellido materno"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= FILA 3: CORREO ELECTRÓNICO ================= -->

    <!-- Etiqueta: Correo electrónico -->
    <TextView
        android:id="@+id/tvEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Correo electrónico"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardPaternalLastNameInput" />

    <!-- Contenedor estilizado: Correo electrónico -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmailInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmailLabel">

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="emailAddress"
            android:background="@android:color/transparent"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= FILA 4: CONTRASEÑA ================= -->

    <!-- Etiqueta: Contraseña -->
    <TextView
        android:id="@+id/tvPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Contraseña"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardEmailInput" />

    <!-- Contenedor estilizado: Contraseña -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPasswordInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="newPassword"
            android:background="@android:color/transparent"
            android:hint="********"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= FILA 5: REPITE TU CONTRASEÑA ================= -->

    <!-- Etiqueta: Repite tu contraseña -->
    <TextView
        android:id="@+id/tvConfirmPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Repite tu contraseña"
        android:textColor="#1E293B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardPasswordInput" />

    <!-- Contenedor estilizado: Repite tu contraseña -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConfirmPasswordInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmPasswordLabel">

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="newPassword"
            android:background="@android:color/transparent"
            android:hint="********"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- CheckBox: Mostrar contraseña -->
    <CheckBox
        android:id="@+id/cbShowPassword"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:minHeight="40dp"
        android:text="Mostrar contraseña"
        android:textColor="#475569"
        android:textSize="13sp"
        app:buttonTint="#0284C7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardConfirmPasswordInput" />

    <!-- Botón Principal: ¡Crear cuenta! -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegister"
        android:layout_width="210dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.03"
        android:text="¡Crear cuenta!"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#0D9488"
        app:cornerRadius="14dp"
        app:rippleColor="#5EEAD4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cbShowPassword" />

    <!-- Enlace inferior: ¿Ya tienes una cuenta? Inicia sesión aquí. -->
    <TextView
        android:id="@+id/tvGoToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:padding="4dp"
        android:text="¿Ya tienes una cuenta? Inicia sesión aquí."
        android:textColor="#0369A1"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRegister"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
