<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp"
    android:visibility="gone">
    <TextView android:id="@+id/feedFilterSummary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Filtra tu actividad" android:textColor="@color/app_text_secondary" android:textSize="13sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/activityFilterGroup"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/filterPlaces"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:text="Lugares" />
            <com.google.android.material.chip.Chip android:id="@+id/filterReviews"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Reseñas" />
            <com.google.android.material.chip.Chip android:id="@+id/filterReports"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Reportes" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <Spinner android:id="@+id/activityDetailFilter" android:layout_width="match_parent"
        android:layout_height="50dp" android:layout_marginTop="6dp"
        android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
        android:visibility="gone" />
</LinearLayout>
