<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet" android:orientation="vertical"
    android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
    <View android:layout_width="42dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp" android:background="@color/app_border" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Varias alertas en esta zona" android:textColor="@color/app_text_primary"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Elige el reporte que deseas consultar"
                android:textColor="@color/app_text_secondary" android:textSize="14sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnCloseReportSelection" android:layout_width="48dp"
            android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar" android:padding="12dp" android:src="@drawable/ic_close"
            app:tint="@color/app_text_secondary" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:fillViewport="true">
        <LinearLayout android:id="@+id/reportSelectionList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
