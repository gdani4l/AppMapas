<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/reportOptionCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp"
    app:strokeColor="@color/app_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <View android:id="@+id/reportOptionAccent" android:layout_width="6dp" android:layout_height="64dp"
            android:background="#F97316" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/reportOptionTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/app_text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/reportOptionMeta" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="@color/app_primary_dark" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/reportOptionDescription" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2"
                android:ellipsize="end" android:textColor="@color/app_text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp"
            android:contentDescription="Abrir reporte" android:src="@drawable/ic_arrow_forward"
            app:tint="@color/app_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
